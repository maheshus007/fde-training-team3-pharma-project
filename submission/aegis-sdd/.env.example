# COSMOS_GREMLIN_ENDPOINT=
# COSMOS_GREMLIN_KEY=
# COSMOS_GREMLIN_DATABASE=aegis
# COSMOS_GREMLIN_GRAPH=evidence
# AEGIS_ALLOW_LIVE_GRAPH=false
